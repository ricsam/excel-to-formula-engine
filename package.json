{
  "name": "@ricsam/excel-to-formula-engine",
  "version": "0.2.1",
  "description": "Convert an Excel .xlsx file into FormulaEngine WorkbookData, in the browser",
  "type": "module",
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "test": "bun run fixtures && bun test",
    "agent:test": "CLAUDECODE=1 bun run fixtures && CLAUDECODE=1 bun test",
    "typecheck": "tsc --noEmit",
    "fixtures": "bun tests/fixtures/build-fixtures.ts",
    "demo": "bun build demo/demo.ts --target=browser --outfile=demo/demo.js",
    "demo:serve": "bun run demo && bun demo/serve.ts",
    "build": "bun build.ts"
  },
  "keywords": [
    "excel",
    "xlsx",
    "spreadsheet",
    "formula-engine",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricsam/excel-to-formula-engine.git"
  },
  "bugs": {
    "url": "https://github.com/ricsam/excel-to-formula-engine/issues"
  },
  "homepage": "https://github.com/ricsam/excel-to-formula-engine#readme",
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.4.2",
    "exceljs": "^4.4.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@ricsam/formula-engine": "0.3.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
